[Unit]
Description=M.I. Engineering Works Django Gunicorn Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=syn
Group=webhost

WorkingDirectory=/var/deployment/mi_engineering

# Load environment configuration
EnvironmentFile=-/var/deployment/mi_engineering/.env

# Default execution environment
Environment="PATH=/var/deployment/mi_engineering/.venv/bin:/usr/local/bin:/usr/bin:/bin:/home/syn/.cargo/bin"
Environment="PORT=8000"
Environment="GUNICORN_TIMEOUT=120"
Environment="PYTHONUNBUFFERED=1"
Environment="LANG=en_US.UTF-8"

# Django startup wrapper
ExecStart=/bin/bash /var/deployment/mi_engineering/entrypoint.sh

# Automatic recovery
Restart=always
RestartSec=5

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=30

# File creation permissions (group-writable for webhost)
UMask=0002

# Resource limits
LimitNOFILE=65536

# Systemd hardening compatible with Django SQLite and media writes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/deployment/mi_engineering /var/db /var/data/media
PrivateTmp=true
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mi_engineering

[Install]
WantedBy=multi-user.target
