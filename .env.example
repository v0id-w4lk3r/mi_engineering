# ==============================================================================
# Django Production Environment Configuration Template (.env.example)
# Copy this file to .env in the application root (/var/deployment/mi_engineering/.env)
# Command: cp .env.example .env && chmod 600 .env
# ==============================================================================

# Environment mode: prod / dev
ENV=prod
DJANGO_SETTINGS_MODULE=mi_engineering.settings.prod

# Production Secret Key
# Generate one using: python3 -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-50-characters

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed Hosts (Comma-separated domains or IP addresses)
DJANGO_ALLOWED_HOSTS=miengineeringworks.in,www.miengineeringworks.in,127.0.0.1,localhost
ALLOWED_HOSTS=miengineeringworks.in,www.miengineeringworks.in,127.0.0.1,localhost

# CSRF Trusted Origins (Comma-separated full URLs with https:// scheme)
CSRF_TRUSTED_ORIGINS=https://miengineeringworks.in,https://www.miengineeringworks.in

# SSL / HTTPS Configuration
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Application Paths
STATIC_ROOT=/var/deployment/mi_engineering/staticfiles
STATIC_URL=/static/
MEDIA_ROOT=/var/data/media
MEDIA_URL=/media/
DB_DIR=/var/db

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL="M.I. Engineering Works" <your-email@gmail.com>

# SEO Site Protocol (https)
META_SITE_PROTOCOL=https
