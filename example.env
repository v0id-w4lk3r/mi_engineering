# Django Settings
# prod / dev
ENV=prod

DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DEBUG=False


# Allowed Hosts
# Comma-separated domains/IPs.
# Production example:
# ALLOWED_HOSTS=example.com,www.example.com

ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL)
DB_NAME=db_name
DB_USER=db_admin
DB_PASSWORD=change-this-database-password
DB_HOST=localhost
DB_PORT=5432


# Email / SMTP Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="M.I. Engineering Works <your-email@gmail.com>"